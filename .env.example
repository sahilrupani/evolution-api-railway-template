# ── Evolution API ───────────────────────────────────────────────
# Public URL the API is reached at. Local Docker: keep localhost.
# Production: set to your https domain (needed for QR + webhooks).
SERVER_URL=http://localhost:8080

# Master API key for ALL requests. Generate a strong random string:
#   openssl rand -hex 32
AUTHENTICATION_API_KEY=change_me_to_a_long_random_string

# ── Database (PostgreSQL) ───────────────────────────────────────
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
# NOTE: this is DATABASE_CONNECTION_URI for self-host (NOT DATABASE_URL).
# Host is the compose service name "postgres". If you change the password
# below, update it here too — the two must match.
DATABASE_CONNECTION_URI=postgresql://evolution:evolution@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution

# Credentials for the bundled postgres container (compose reads these)
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evolution
POSTGRES_DB=evolution

# ── Cache (Redis) ───────────────────────────────────────────────
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false

# ── Optional ────────────────────────────────────────────────────
# LOG_LEVEL=ERROR
# DEL_INSTANCE=false
# LANGUAGE=en          # en | pt-BR | es
